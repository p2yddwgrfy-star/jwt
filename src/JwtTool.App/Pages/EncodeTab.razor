@using JwtTool.TokenOperations
@inject IJSRuntime JS

<div class="encode-grid">
    <label>
        Header
        <textarea id="enc-header" rows="6" value="@Draft.HeaderJson" @oninput="OnHeaderInput"></textarea>
    </label>
    <label>
        Payload
        <textarea id="enc-payload" rows="6" value="@Draft.PayloadJson" @oninput="OnPayloadInput"></textarea>
    </label>
</div>

<KeyEntry ControlsClass="encode-controls"
          TextAreaId="enc-key"
          Algorithm="Draft.Algorithm"
          AlgorithmChanged="OnAlgorithmChanged"
          KeyText="@Draft.Key"
          KeyTextChanged="OnKeyInput"
          RsaKeyWording="PEM private key"
          RsaKeyPlaceholder="@PrivateKeyPlaceholder"
          HintLead="@(Draft.Algorithm == SignatureAlgorithm.RS256
              ? "Pick a private key to sign the Token."
              : "Pick a Key to see the signed Token. Nothing leaves your browser.")"
          BoundaryHint="@(Draft.Algorithm == SignatureAlgorithm.RS256)"
          ShowHint="@(Error is null)" />

<h2 class="section-title">Token</h2>
@if (Error is not null)
{
    <div class="parse-error">@Error</div>
}
else if (Token is not null)
{
    var encParts = Token.Split('.');
    <pre class="json token-output" id="encoded-token"><span class="part header-part">@encParts.ElementAtOrDefault(0)</span>.<span class="part payload-part">@encParts.ElementAtOrDefault(1)</span>.<span class="part signature-part">@encParts.ElementAtOrDefault(2)</span></pre>
    <button class="ghost" @onclick="CopyEncodedToken">Copy token</button>
    @if (copyStatus is not null)
    {
        <span class="copy-status">@copyStatus</span>
    }
}

@code {
    private const string PrivateKeyPlaceholder = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----";

    // The Encode draft is owned by the page (tab state); this component is its
    // stateless presenter: draft in as one parameter, edits out as one event.
    [Parameter, EditorRequired] public EncodeDraft Draft { get; set; } = new("", "", "", SignatureAlgorithm.HS256);

    [Parameter, EditorRequired] public EventCallback<EncodeDraft> DraftChanged { get; set; }

    private string? Token { get; set; }
    private string? Error { get; set; }
    private string? copyStatus;

    // RS256 signing goes through the browser's Web Crypto — WASM has no RSA (ADR-0002).
    private EncodeFlow flow = default!;

    protected override void OnInitialized() =>
        flow = new((signingInput, pem) =>
            new ValueTask<byte[]>(RsaWebCrypto.SignAsync(JS, signingInput, pem)));

    private Task OnHeaderInput(ChangeEventArgs e) => Emit(e.Value?.ToString() ?? "", null, null, null);

    private Task OnPayloadInput(ChangeEventArgs e) => Emit(null, e.Value?.ToString() ?? "", null, null);

    private Task OnKeyInput(string keyText) => Emit(null, null, keyText, null);

    private Task OnAlgorithmChanged(SignatureAlgorithm algorithm) => Emit(null, null, null, algorithm);

    private Task Emit(string? header, string? payload, string? key, SignatureAlgorithm? algorithm)
    {
        var draft = Draft with
        {
            HeaderJson = header ?? Draft.HeaderJson,
            PayloadJson = payload ?? Draft.PayloadJson,
            Key = key ?? Draft.Key,
            Algorithm = algorithm ?? Draft.Algorithm,
        };
        return DraftChanged.InvokeAsync(draft);
    }

    // Re-encode only when the draft actually changed, not on every parent re-render.
    private EncodeDraft? lastSeenDraft;

    protected override Task OnParametersSetAsync()
    {
        if (lastSeenDraft == Draft)
            return Task.CompletedTask;
        lastSeenDraft = Draft;
        return Reencode();
    }

    private async Task Reencode()
    {
        await flow.EncodeAsync(Draft, outcome =>
        {
            Token = outcome.Token;
            Error = outcome.Error;
            StateHasChanged();
        });
    }

    private async Task CopyEncodedToken() =>
        copyStatus = await Clipboard.CopyAsync(JS, Token ?? "");
}
